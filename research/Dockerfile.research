# Образ для research/recalibrate_for_model.sh на GPU (research/a5000_session.sh): образ сервиса + pandas и
# matplotlib — их импортируют research/honest_eval.py, official_evaluate.py и threshold_vs_gallery.py.
# Версии точные (Q39); numpy и pillow закреплены как в api/requirements.txt, чтобы pip их не трогал.
#   docker build -t case17-api-research:local --build-arg BASE=case17-api:local - < research/Dockerfile.research
ARG BASE=case17-api:local
FROM ${BASE}
RUN pip install --no-cache-dir pandas==3.0.6 matplotlib==3.11.2 numpy==2.1.3 pillow==11.1.0
