# GPU-вариант образа. Код тот же, отличается база и onnxruntime.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ARG EMBED_MODEL=reid:vit_base_patch16_siglip_224.webli
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/hfcache \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3.11 python3-pip libturbojpeg0 \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf /usr/bin/python3.11 /usr/local/bin/python

WORKDIR /srv

COPY requirements.txt .
# CPU-колесо torch тут не нужно: ставим обычное с CUDA и onnxruntime-gpu
RUN sed -e '/download.pytorch.org/d' -e 's/torch==2.5.1+cpu/torch==2.5.1/' \
        -e 's/torchvision==0.20.1+cpu/torchvision==0.20.1/' \
        -e 's/onnxruntime==/onnxruntime-gpu==/' requirements.txt > requirements.gpu.txt \
 && pip install --no-cache-dir -r requirements.gpu.txt

# EMBED_MODEL бывает reid:<бэкбон>, timm:<бэкбон> или onnx:<путь> — см. Dockerfile
RUN python -c "\
import timm, os; \
name = os.environ.get('EMBED_MODEL', '${EMBED_MODEL}'); \
skip = name.startswith('onnx:'); \
name = name.split(':', 1)[1] if ':' in name else name; \
print('onnx-граф монтируется снаружи, запекать нечего') if skip else None; \
m = None if skip else timm.create_model(name, pretrained=True, num_classes=0); \
print('весов запечено:', name, m.num_features) if m is not None else None"

COPY app ./app
COPY scripts ./scripts

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
