# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Секреты — НИКОГДА в репозиторий
.env
*.pem
*.key
id_*

# Данные и веса (лежат вне репозитория).
# Ведущий слеш обязателен: без него шаблон матчится на любом уровне
# вложенности, и models/ съедает api/app/models/ — пакет кода, а не веса.
/data/*
/crops/
*.tar
/models/
*.pth
*.pt
*.onnx
*.safetensors

# Артефакты сдачи — ЭТИ ФАЙЛЫ КОММИТИМ (требование README датасета)
# embeddings_index.csv и postprocess.json тоже нужны: scripts/validate_submission.py
# проверяет по первому порядок строк embeddings.npy, а по второму — что
# submission.csv воспроизводится из векторов записанным рядом конвейером.
# Без postprocess.json проверка происхождения из чистого клона не проходит.
artifacts/*
!artifacts/.gitkeep
!artifacts/submission.csv
!artifacts/candidates.csv
!artifacts/embeddings.npy
!artifacts/embeddings_index.csv
!artifacts/postprocess.json

# research
research/.venv/
research/__pycache__/
research/*.npy

# research: коммитим только скрипты, val_ids.txt и results.md
# Со слешем на конце git исключает саму папку и внутрь уже не заглядывает,
# поэтому ни одно исключение ниже не сработало бы. Нужна звёздочка.
research/results/*
research/val_split.csv

# Исключение: итоговые замеры, на которые ссылаются README и слайды.
# Файлы по килобайту, но без них ни одну цифру в документах нельзя
# проверить, не пересчитывая полчаса на CPU.
!research/results/service_path.json
!research/results/service_path_extras.json
!research/results/demo_cases.json
!research/results/demo_verified.json
!research/results/ann/
research/results/ann/*
!research/results/ann/summary.json

# Исключения: это часть решения, а не мусор.
# Обученная голова (5 МБ) обязана ехать вместе с клоном, иначе у постороннего
# человека поднимется не наша модель — см. scripts/check_reproducibility.sh.
!/weights/
!/weights/*.pt
# Пустая папка под данные, чтобы монтирование по умолчанию не падало.
!/data/.gitkeep
