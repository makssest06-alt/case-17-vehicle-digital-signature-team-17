# Скопируй в .env и подставь свои значения. .env в git не попадает.
POSTGRES_USER=case17
POSTGRES_PASSWORD=change_me
POSTGRES_DB=case17

# Модель эмбеддингов. Production этой ветки — clean student ViT-L/16@256
# (150 эпох, seed 7): одна модель SigLIP Large, clean train/holdout split без
# пяти exact duplicate-пар, 512D, squash, TTA выключен.
#
# Веса полного дообучения (энкодер целиком) приходят из чекпоинта,
# поэтому запекание pretrained в образе для них не нужно — но Dockerfile
# всё равно тянет совместимый public backbone для сборки образа.
#
# ВАЖНО: студент обучен на squash-кропе (вся машина целиком), а чекпоинт
# args["tf_mode"] не содержит — режим задаётся переменной REID_TF_MODE.
# Без неё загрузчик возьмёт base-кроп и потеряет ~2 mAP.
EMBED_MODEL=reid:vit_large_patch16_siglip_256
EMBED_DIM=512
INPUT_SIZE=256
REID_WEIGHTS=/opt/weights/soup150s2.pt
# Веса скачиваются при сборке по WEIGHTS_URL и сверятся по sha256 (README, раздел 3).
# По умолчанию уже стоит ассет GitHub Release weights-soup150s2 (docker-compose.yml, api/Dockerfile);
# задавать переменную — только чтобы сменить источник.
# WEIGHTS_URL=https://github.com/makssest06-alt/case-17-vehicle-digital-signature-team-17/releases/download/weights-soup150s2/soup150s2.pt
REID_TF_MODE=squash

# Усреднение оригинала и отражения. Студенту TTA не нужен: прежнему студенту он
# давал +0.33 mAP@10 (0.8859 -> 0.8892; 361 gallery, сплит до clean retrain) ценой
# 170 -> 343 мс/кадр на CPU (2 потока). Для прежней head-only модели было +2.17.
EMBED_TTA_FLIP=0

# Поиск. Порог откалиброван на том распределении, в котором работает сервис
# (галерея не фильтруется по камере — ТЗ п.5: camera_id на вход не подаётся).
#
# Production: отказ по сырому косинусу (raw) лучшего кандидата после DBA, без почти-дублей; z100 — по выбору.
# Пороги — REFUSAL_PRESETS в api/app/config.py, разбор — docs/refusal.md.
SEARCH_TOP_N=10
# SEARCH_THRESHOLD=0.8881         # по умолчанию — из api/app/config.py (одно место); задавать, только чтобы сменить
# Строгая точка: TNR ≥ 0.98 — когда ложное совпадение дороже пропуска.
# Используется демо-режимом в вебе.
# SEARCH_THRESHOLD_STRICT=0.9445  # то же
MAX_UPLOAD_MB=20

# Ресурсы контейнера api. Значения по умолчанию рассчитаны на ViT-L@256
# (веса 1.21 ГБ, пик RSS при загрузке ~2.6 ГБ, старт ~4 с на GPU).
API_MEM_LIMIT=3g
API_START_PERIOD=90s

# Где на хосте лежат данные и свои веса. Веса soup150s2 запекаются в образ при сборке
# (api/Dockerfile, /opt/weights) по WEIGHTS_URL (в git их нет — 1.21 ГБ).
# Данные не обязательны для старта: сервис поднимется и с пустой папкой.
DATA_HOST_DIR=./data
MODELS_HOST_DIR=./weights

# --- Режим отказа и постобработка (docs/refusal.md, api/app/pp/state.py) ---
# Production-значения уже в api/app/config.py; раскомментировать — только чтобы сменить.
# По умолчанию — пресет «DBA»: PP_DEDUP_REFUSAL=off, SEARCH_THRESHOLD=0.8881, SEARCH_THRESHOLD_STRICT=0.9445 (api/app/config.py, recalibrate_soup150s2.json); блок «Итог» ниже — прежний итог, теперь запасной (docs/refusal.md).
# Итог (361 / 1111): ранжирование DBA k=1 без флагов, отказ raw без почти-дублей «фон ИЛИ рамка».
# REFUSAL_SCORE=raw           # косинус лучшего без почти-дублей; z100 = (s1 − mean(s2..s100)) / std(s2..s100)
# PP_DBA_K=1                  # DBA галереи по 1 соседу (колонка embedding_dba)
# PP_CAMERA_PENALTY=on        # хранить признак фона кадра (нужен отказу)
# PP_DEDUP_RANK=off           # в конец ранжирования: off | bbox | bg | both (фон — нет: docs/refusal.md)
# PP_DEDUP_REFUSAL=off        # не учитывать в отказе: off | bbox | bg | both (OR); both — запасной пресет
# PP_DEDUP_SIM_ANY=inf        # рамки: сырой косинус ≥ — почти-дубль без рамки (у Андрея 0.94)
# PP_DEDUP_SIM=0.87           # рамки: сырой косинус ≥ (вместе с рамкой)
# PP_DEDUP_IOU=0.6            # рамки: IoU ≥
# PP_DEDUP_CENTER=0.3         # рамки: сдвиг центра ≤ доли размера рамки
# PP_DEDUP_SIZE=inf           # рамки: |log| отношения сторон ≤ (inf — не проверять)
# PP_CAMERA_TAU=0.68233       # фон: косинус > τ — «та же камера»
# PP_CAMERA_TOPK=100          # сколько кандидатов проверять
# SEARCH_THRESHOLD=0.8195       # raw, запасной пресет (1,"off","both","raw"): максимум 0.7·F1 + 0.3·TNR (Q15); 361 и 361 + 750 обучающих, 20 % машин без пары (Q17)
# SEARCH_THRESHOLD_STRICT=0.9443  # raw, наименьший с TNR ≥ 0.98 на обеих галереях
# Запасной план без фона (FPS): PP_CAMERA_PENALTY=off, PP_DEDUP_RANK=off, PP_DEDUP_REFUSAL=bbox,
# SEARCH_THRESHOLD=0.8244, SEARCH_THRESHOLD_STRICT=0.9442.
# z100 вместо raw (пресет «DBA»): REFUSAL_SCORE=z100, SEARCH_THRESHOLD=4.2787, SEARCH_THRESHOLD_STRICT=8.698
# (запасные: фон ИЛИ рамка 4.3777 / 8.5204, без фона 4.4228 / 8.5754).

# sha256 файла весов: при старте сервис пишет его в лог и сверяет с этим (не совпал — предупреждение).
# soup150s2: 64e2f1897b593d9de7100fd6449058f0fad57f98de0bcbdfe4c546c5a6a21553
# REID_WEIGHTS_SHA256=

# --- Скорость extract() (README, раздел 6; разрешены ответом Q36) ---
# Прод-дефолты уже в коде (api/app/imaging.py, api/app/extractor.py); задавать — только чтобы сменить.
# EXTRACT_JPEG_DRAFT общий для extract(), сервиса и make_submission (app/imaging.crop_frame).
# EXTRACT_JPEG_DRAFT=2    # JPEG декодируется сразу в половинном размере: на A5000 86 -> 141 FPS,
                          # качество −0.003/−0.005 mAP@10 (extract_flags_soup150s2). 0 — полный декод.
# EXTRACT_THREADS=32      # потоков декода батча; на результат не влияет, только скорость.
                          # Дефолт 32 — под 64 ядра жюри (2× Xeon Gold 6338, Q30).
