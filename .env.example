# Скопируй в .env и подставь свои значения. .env в git не попадает.
POSTGRES_USER=case17
POSTGRES_PASSWORD=change_me
POSTGRES_DB=case17

# Модель эмбеддингов. По умолчанию — наша итоговая конфигурация:
# бэкбон SigLIP base (Apache 2.0) скачивается при сборке образа и запекается
# внутрь, обученная голова лежит в репозитории (weights/reid_current.pt, 5 МБ).
# Ничего дополнительно скачивать не нужно, в рантайме интернет не требуется.
EMBED_MODEL=reid:vit_base_patch16_siglip_224.webli
EMBED_DIM=512
INPUT_SIZE=224
REID_WEIGHTS=/models/reid_current.pt

# Усреднение оригинала и отражения: +2.17 mAP ценой двукратного замедления.
# Ставь 0, если пропускная способность важнее качества.
EMBED_TTA_FLIP=1

# Поиск. Порог откалиброван на том распределении, в котором работает сервис
# (галерея не фильтруется по камере) — обоснование в docs/SUBMISSION_README.md.
SEARCH_TOP_N=10
SEARCH_THRESHOLD=0.5114
# Строгая точка: TNR 0.982, точность 0.979, полнота 0.852 — когда ложное
# совпадение дороже пропуска. Используется демо-режимом в вебе.
SEARCH_THRESHOLD_STRICT=0.6354
MAX_UPLOAD_MB=20

# Ресурсы контейнера api. Значения по умолчанию рассчитаны на одиночную
# модель (пик 770 МБ, старт 2 с). Для ансамбля из четырёх моделей замер дал
# пик 2296 МБ и 147 с на загрузку, поэтому вместе с ENSEMBLE_N=4 надо поднять
# и эти два параметра, иначе контейнер будет убит по памяти или помечен
# нездоровым раньше, чем успеет подняться.
#   ENSEMBLE_N=4 -> API_MEM_LIMIT=3g, API_START_PERIOD=240s
API_MEM_LIMIT=1536m
API_START_PERIOD=90s

# Где на хосте лежат данные и веса.
# weights/ лежит в репозитории, поэтому чистый клон поднимается как есть.
# Данные не обязательны для старта: сервис поднимется и с пустой папкой.
DATA_HOST_DIR=./data
MODELS_HOST_DIR=./weights
