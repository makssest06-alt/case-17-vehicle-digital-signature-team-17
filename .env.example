# Скопируй в .env и подставь свои значения. .env в git не попадает.
POSTGRES_USER=case17
POSTGRES_PASSWORD=change_me
POSTGRES_DB=case17

# Модель эмбеддингов. Итоговая конфигурация — дистиллированный студент:
# одна модель SigLIP 2 ViT-B/16 вместо ансамбля из четырёх, 170 мс/кадр,
# 362 МБ весов, пик RAM ~795 МБ (влезает в API_MEM_LIMIT=1536m).
#
# Веса полного дообучения (162 тензора энкодера) приходят из чекпоинта,
# поэтому запекание pretrained в образе для них не нужно — но Dockerfile
# всё равно тянет SigLIP 1, чтобы head-only чекпоинт weights/reid_current.pt
# оставался рабочим запасным вариантом.
#
# ВАЖНО: студент обучен на squash-кропе (вся машина целиком), а чекпоинт
# args["tf_mode"] не содержит — режим задаётся переменной REID_TF_MODE.
# Без неё загрузчик возьмёт base-кроп и потеряет ~2 mAP.
EMBED_MODEL=reid:vit_base_patch16_siglip_224.webli
EMBED_DIM=512
INPUT_SIZE=224
REID_WEIGHTS=/models/siglip2_distill_ensemble_ep28.pt
REID_TF_MODE=squash

# Усреднение оригинала и отражения. Студенту TTA не нужен: он уже даёт
# 88.59 mAP@10 без него, а включение стоит 170 -> 343 мс/кадр за +0.33.
# Для прежней head-only модели было +2.17, поэтому флаг и стоял в 1.
EMBED_TTA_FLIP=0

# Поиск. Порог откалиброван на том распределении, в котором работает сервис
# (галерея не фильтруется по камере — ТЗ п.5: camera_id на вход не подаётся).
#
# Значения пересчитаны под студента: он сравнивает по СЫРОМУ косинусу top-1
# (api/app/main.py: best < thr), а распределение у него другое, чем у прежней
# head-only модели. Калибровка analysis/refusal_threshold_student.py на трёх
# зёрнах синтетического open-set (половина машин убрана из галереи):
#   AUC 0.981..0.987 (было 0.963), медианы pos 0.96 / neg 0.52
#   точка Юдена:  thr 0.7985..0.8285, F1 0.928..0.956, TNR 0.960..0.967
#   TNR >= 0.98:  thr 0.8425..0.8625, точность 0.979..0.981
# Прежние 0.5114 / 0.6354 остались от p_baseline — на студенте такой порог
# почти не отказывал бы: медиана косинуса у запросов без пары 0.52.
SEARCH_TOP_N=10
# SEARCH_THRESHOLD=0.8025         # по умолчанию — из api/app/config.py (одно место); задавать, только чтобы сменить
# Строгая точка: TNR 0.982 — когда ложное совпадение дороже пропуска.
# Используется демо-режимом в вебе.
# SEARCH_THRESHOLD_STRICT=0.8465  # то же
MAX_UPLOAD_MB=20

# Ресурсы контейнера api. Значения по умолчанию рассчитаны на одиночную
# модель (пик 770 МБ, старт 2 с). Для ансамбля из четырёх моделей замер дал
# пик 2296 МБ и 147 с на загрузку, поэтому вместе с ENSEMBLE_N=4 надо поднять
# и эти два параметра, иначе контейнер будет убит по памяти или помечен
# нездоровым раньше, чем успеет подняться.
#   ENSEMBLE_N=4 -> API_MEM_LIMIT=3g, API_START_PERIOD=240s
API_MEM_LIMIT=1536m
API_START_PERIOD=90s

# Где на хосте лежат данные и веса.
# weights/ лежит в репозитории, поэтому чистый клон поднимается как есть.
# Данные не обязательны для старта: сервис поднимется и с пустой папкой.
DATA_HOST_DIR=./data
MODELS_HOST_DIR=./weights

# --- Режим отказа и постобработка (docs/refusal.md, api/app/pp/state.py) ---
# Всё выключено по умолчанию: ответы /v1/search как без постобработки.
# REFUSAL_SCORE=raw          # raw — косинус лучшего кандидата; z100 — (s1 − mean(s2..s100)) / std(s2..s100)
# PP_DBA_K=0                 # 0 — выкл; 1 — DBA галереи по 1 соседу (колонка embedding_dba)
# PP_CAMERA_PENALTY=off      # off | store (хранить признак фона) | on (хранить и штрафовать)
# PP_CAMERA_TAU=0.68127      # косинус фона > τ — кандидат «с той же камеры»
# PP_CAMERA_TOPK=100         # сколько кандидатов из базы проверять на камеру
# Включили постобработку — поменяйте SEARCH_THRESHOLD (и STRICT) на значение из
# REFUSAL_PRESETS в api/app/config.py: старый порог к новому скору не подходит.
