# Скопируй в .env и подставь свои значения. .env в git не попадает.
POSTGRES_USER=case17
POSTGRES_PASSWORD=change_me
POSTGRES_DB=case17

# Модель эмбеддингов
EMBED_MODEL=resnet18
EMBED_DIM=512
INPUT_SIZE=224

# Поиск
SEARCH_TOP_N=10
SEARCH_THRESHOLD=0.75
MAX_UPLOAD_MB=20

# Где на хосте лежат данные и веса. По умолчанию — пути нашего сервера.
# На чужой машине достаточно поменять здесь, без правки docker-compose.yml.
DATA_HOST_DIR=/opt/case17/data
MODELS_HOST_DIR=/opt/case17/models
