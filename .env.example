DATA_HOST_DIR=./data
MODELS_HOST_DIR=./weights

# --- Р РµР¶РёРј РѕС‚РєР°Р·Р° Рё РїРѕСЃС‚РѕР±СЂР°Р±РѕС‚РєР° (docs/refusal.md, api/app/pp/state.py) ---
# Р’СЃС‘ РІС‹РєР»СЋС‡РµРЅРѕ РїРѕ СѓРјРѕР»С‡Р°РЅРёСЋ: РѕС‚РІРµС‚С‹ /v1/search РєР°Рє Р±РµР· РїРѕСЃС‚РѕР±СЂР°Р±РѕС‚РєРё.
# Production: DBA k=1 + РїСЂР°РІРёР»Рѕ РђРЅРґСЂРµСЏ bbox OR background + z100.
REFUSAL_SCORE=z100          # (s1 в€’ mean(s2..s100)) / std(s2..s100)
PP_DBA_K=1                  # DBA РіР°Р»РµСЂРµРё РїРѕ 1 СЃРѕСЃРµРґСѓ (РєРѕР»РѕРЅРєР° embedding_dba)
PP_CAMERA_PENALTY=on        # С…СЂР°РЅРёС‚СЊ Рё РёСЃРїРѕР»СЊР·РѕРІР°С‚СЊ РїСЂРёР·РЅР°Рє С„РѕРЅР°
# PP_CAMERA_TAU=0.68127      # РєРѕСЃРёРЅСѓСЃ С„РѕРЅР° > П„ вЂ” РєР°РЅРґРёРґР°С‚ В«СЃ С‚РѕР№ Р¶Рµ РєР°РјРµСЂС‹В»
# PP_CAMERA_TOPK=100         # СЃРєРѕР»СЊРєРѕ РєР°РЅРґРёРґР°С‚РѕРІ РёР· Р±Р°Р·С‹ РїСЂРѕРІРµСЂСЏС‚СЊ РЅР° РєР°РјРµСЂСѓ
PP_DEDUP=both              # bbox OR РґРµС€С‘РІС‹Р№ С„РѕРЅ (РїСЂР°РІРёР»Рѕ РђРЅРґСЂРµСЏ)
# PP_DEDUP_SIM=0.84          # bbox: СЃС‹СЂРѕР№ РєРѕСЃРёРЅСѓСЃ в‰Ґ
# PP_DEDUP_IOU=0.6           # bbox: IoU СЂР°РјРѕРє в‰Ґ
# PP_DEDUP_CENTER=0.3        # bbox: СЃРґРІРёРі С†РµРЅС‚СЂР° в‰¤ РґРѕР»Рё СЂР°Р·РјРµСЂР° СЂР°РјРєРё
# PP_DEDUP_SIZE=inf          # bbox: |log| РѕС‚РЅРѕС€РµРЅРёСЏ СЃС‚РѕСЂРѕРЅ в‰¤
SEARCH_THRESHOLD=4.1592
SEARCH_THRESHOLD_STRICT=7.3031
# Р­С‚Рё РїРѕСЂРѕРіРё РѕС‚РЅРѕСЃСЏС‚СЃСЏ Рє z100 РїРѕСЃР»Рµ DBA/РґРµРґСѓРї Рё РЅРµ СЃРѕРІРјРµСЃС‚РёРјС‹ СЃ raw 0.8025.

