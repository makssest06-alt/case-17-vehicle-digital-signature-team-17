# Скопируй в .env и подставь свои значения. .env в git не попадает.
POSTGRES_USER=case17
POSTGRES_PASSWORD=change_me
POSTGRES_DB=case17

# Модель эмбеддингов. Production — clean student alpha=10:
# одна модель SigLIP 2 ViT-B/16, clean train/holdout split без пяти exact
# duplicate-пар, 512D, squash, TTA выключен.
#
# Веса полного дообучения (162 тензора энкодера) приходят из чекпоинта,
# поэтому запекание pretrained в образе для них не нужно — но Dockerfile
# всё равно тянет совместимый public backbone для сборки образа.
#
# ВАЖНО: студент обучен на squash-кропе (вся машина целиком), а чекпоинт
# args["tf_mode"] не содержит — режим задаётся переменной REID_TF_MODE.
# Без неё загрузчик возьмёт base-кроп и потеряет ~2 mAP.
EMBED_MODEL=reid:vit_base_patch16_siglip_224.webli
EMBED_DIM=512
INPUT_SIZE=224
REID_WEIGHTS=/models/clean_student_a10_ep28.pt
REID_TF_MODE=squash

# Усреднение оригинала и отражения. Студенту TTA не нужен: он уже даёт
# 88.59 mAP@10 без него, а включение стоит 170 -> 343 мс/кадр за +0.33.
# Для прежней head-only модели было +2.17, поэтому флаг и стоял в 1.
EMBED_TTA_FLIP=0

# Поиск. Порог откалиброван на том распределении, в котором работает сервис
# (галерея не фильтруется по камере — ТЗ п.5: camera_id на вход не подаётся).
#
# Production: отказ по z100 после DBA и исключения почти-дублей, не по сырому косинусу.
# Пороги — REFUSAL_PRESETS в api/app/config.py, разбор — docs/refusal.md.
SEARCH_TOP_N=10
# SEARCH_THRESHOLD=4.1592         # по умолчанию — из api/app/config.py (одно место); задавать, только чтобы сменить
# Строгая точка: TNR 0.982 — когда ложное совпадение дороже пропуска.
# Используется демо-режимом в вебе.
# SEARCH_THRESHOLD_STRICT=7.3031  # то же
MAX_UPLOAD_MB=20

# Ресурсы контейнера api. Значения по умолчанию рассчитаны на одиночную
# модель (пик 770 МБ, старт 2 с). Для ансамбля из четырёх моделей замер дал
# пик 2296 МБ и 147 с на загрузку, поэтому вместе с ENSEMBLE_N=4 надо поднять
# и эти два параметра, иначе контейнер будет убит по памяти или помечен
# нездоровым раньше, чем успеет подняться.
#   ENSEMBLE_N=4 -> API_MEM_LIMIT=3g, API_START_PERIOD=240s
API_MEM_LIMIT=1536m
API_START_PERIOD=90s

# Где на хосте лежат данные и веса.
# weights/ лежит в репозитории, поэтому чистый клон поднимается как есть.
# Данные не обязательны для старта: сервис поднимется и с пустой папкой.
DATA_HOST_DIR=./data
MODELS_HOST_DIR=./weights

# --- Режим отказа и постобработка (docs/refusal.md, api/app/pp/state.py) ---
# Production (glebmain): DBA k=1 + исключение почти-дублей (фон OR рамка) + z100.
REFUSAL_SCORE=z100          # (s1 − mean(s2..s100)) / std(s2..s100)
PP_DBA_K=1                  # DBA галереи по 1 соседу (колонка embedding_dba)
PP_CAMERA_PENALTY=on        # хранить и использовать признак фона
# PP_CAMERA_TAU=0.68127      # косинус фона > τ — кандидат «с той же камеры»
# PP_CAMERA_TOPK=100         # сколько кандидатов из базы проверять на камеру
PP_DEDUP=both               # исключать почти-дубли: off | bbox (сходство + рамка) | bg (фон) | both (OR)
# PP_DEDUP_SIM=0.84          # bbox: сырой косинус ≥
# PP_DEDUP_IOU=0.6           # bbox: IoU рамок ≥
# PP_DEDUP_CENTER=0.3        # bbox: сдвиг центра ≤ доли размера рамки
# PP_DEDUP_SIZE=inf          # bbox: |log| отношения сторон ≤
SEARCH_THRESHOLD=4.1592
SEARCH_THRESHOLD_STRICT=7.3031
# Эти пороги относятся к z100 после DBA и исключения почти-дублей, с raw 0.8025 они несовместимы.

# sha256 файла весов: при старте сервис пишет его в лог и сверяет с этим (не совпал — предупреждение).
# a10: 93114c5923869d01e92cd70c2c421f783d05ebdac5652a1f2dc919aa040bf6ce
# REID_WEIGHTS_SHA256=
