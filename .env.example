# Скопируй в .env и подставь свои значения. .env в git не попадает.
POSTGRES_USER=case17
POSTGRES_PASSWORD=change_me
POSTGRES_DB=case17

# Модель эмбеддингов. Production — clean student alpha=10:
# одна модель SigLIP 2 ViT-B/16, clean train/holdout split без пяти exact
# duplicate-пар, 512D, squash, TTA выключен.
#
# Веса полного дообучения (162 тензора энкодера) приходят из чекпоинта,
# поэтому запекание pretrained в образе для них не нужно — но Dockerfile
# всё равно тянет совместимый public backbone для сборки образа.
#
# ВАЖНО: студент обучен на squash-кропе (вся машина целиком), а чекпоинт
# args["tf_mode"] не содержит — режим задаётся переменной REID_TF_MODE.
# Без неё загрузчик возьмёт base-кроп и потеряет ~2 mAP.
EMBED_MODEL=reid:vit_base_patch16_siglip_224.webli
EMBED_DIM=512
INPUT_SIZE=224
REID_WEIGHTS=/opt/weights/clean_student_a10_ep28.pt
# Без git-lfs веса скачаются при сборке по WEIGHTS_URL и сверятся по sha256 (README, раздел 3).
# По умолчанию уже стоит ассет GitHub Release weights-a10 (docker-compose.yml, api/Dockerfile);
# задавать переменную — только чтобы сменить источник.
# WEIGHTS_URL=https://github.com/makssest06-alt/case-17-vehicle-digital-signature-team-17/releases/download/weights-a10/clean_student_a10_ep28.pt
REID_TF_MODE=squash

# Усреднение оригинала и отражения. Студенту TTA не нужен: прежнему студенту он
# давал +0.33 mAP@10 (0.8859 -> 0.8892; 361 gallery, сплит до clean retrain) ценой
# 170 -> 343 мс/кадр на CPU (2 потока). Для прежней head-only модели было +2.17.
EMBED_TTA_FLIP=0

# Поиск. Порог откалиброван на том распределении, в котором работает сервис
# (галерея не фильтруется по камере — ТЗ п.5: camera_id на вход не подаётся).
#
# Production: отказ по сырому косинусу (raw) лучшего кандидата после DBA, без почти-дублей; z100 — по выбору.
# Пороги — REFUSAL_PRESETS в api/app/config.py, разбор — docs/refusal.md.
SEARCH_TOP_N=10
# SEARCH_THRESHOLD=0.8562         # по умолчанию — из api/app/config.py (одно место); задавать, только чтобы сменить
# Строгая точка: TNR ≥ 0.98 — когда ложное совпадение дороже пропуска.
# Используется демо-режимом в вебе.
# SEARCH_THRESHOLD_STRICT=0.9294  # то же
MAX_UPLOAD_MB=20

# Ресурсы контейнера api. Значения по умолчанию рассчитаны на одиночную
# модель (пик 770 МБ, старт 2 с). Для ансамбля из четырёх моделей замер дал
# пик 2296 МБ и 147 с на загрузку, поэтому вместе с ENSEMBLE_N=4 надо поднять
# и эти два параметра, иначе контейнер будет убит по памяти или помечен
# нездоровым раньше, чем успеет подняться.
#   ENSEMBLE_N=4 -> API_MEM_LIMIT=3g, API_START_PERIOD=240s
API_MEM_LIMIT=1536m
API_START_PERIOD=90s

# Где на хосте лежат данные и свои веса. Веса a10 запекаются в образ при сборке
# (api/Dockerfile, /opt/weights): из weights/ после git lfs pull или по WEIGHTS_URL.
# Данные не обязательны для старта: сервис поднимется и с пустой папкой.
DATA_HOST_DIR=./data
MODELS_HOST_DIR=./weights

# --- Режим отказа и постобработка (docs/refusal.md, api/app/pp/state.py) ---
# Production-значения уже в api/app/config.py; раскомментировать — только чтобы сменить.
# С 20.10 по умолчанию — пресет «DBA»: PP_DEDUP_REFUSAL=off, SEARCH_THRESHOLD=0.8562, SEARCH_THRESHOLD_STRICT=0.9294 (api/app/config.py); блок «Итог» ниже — итог 18.10, теперь запасной (docs/refusal.md).
# Итог (361 / 1111): ранжирование DBA k=1 без флагов, отказ raw без почти-дублей «фон ИЛИ рамка».
# REFUSAL_SCORE=raw           # косинус лучшего без почти-дублей; z100 = (s1 − mean(s2..s100)) / std(s2..s100)
# PP_DBA_K=1                  # DBA галереи по 1 соседу (колонка embedding_dba)
# PP_CAMERA_PENALTY=on        # хранить признак фона кадра (нужен отказу)
# PP_DEDUP_RANK=off           # в конец ранжирования: off | bbox | bg | both (фон — нет: docs/refusal.md)
# PP_DEDUP_REFUSAL=off        # не учитывать в отказе: off | bbox | bg | both (OR); both — запасной пресет
# PP_DEDUP_SIM_ANY=inf        # рамки: сырой косинус ≥ — почти-дубль без рамки (у Андрея 0.94)
# PP_DEDUP_SIM=0.84           # рамки: сырой косинус ≥ (вместе с рамкой)
# PP_DEDUP_IOU=0.6            # рамки: IoU ≥
# PP_DEDUP_CENTER=0.3         # рамки: сдвиг центра ≤ доли размера рамки
# PP_DEDUP_SIZE=inf           # рамки: |log| отношения сторон ≤
# PP_CAMERA_TAU=0.68127       # фон: косинус > τ — «та же камера»
# PP_CAMERA_TOPK=100          # сколько кандидатов проверять
# SEARCH_THRESHOLD=0.7586       # raw, максимум 0.7·F1 + 0.3·TNR (Q15); 361 и 361 + 750 обучающих, 20 % машин без пары (Q17)
# SEARCH_THRESHOLD_STRICT=0.9302 # raw, наименьший с TNR ≥ 0.98 на обеих галереях
# Запасной план без фона (FPS): PP_CAMERA_PENALTY=off, PP_DEDUP_RANK=off, PP_DEDUP_REFUSAL=bbox,
# SEARCH_THRESHOLD=0.7572, SEARCH_THRESHOLD_STRICT=0.9305.
# z100 вместо raw: REFUSAL_SCORE=z100, SEARCH_THRESHOLD=4.3475, SEARCH_THRESHOLD_STRICT=8.8469
# (запасной: 4.3542 / 8.8363).

# sha256 файла весов: при старте сервис пишет его в лог и сверяет с этим (не совпал — предупреждение).
# a10: 93114c5923869d01e92cd70c2c421f783d05ebdac5652a1f2dc919aa040bf6ce
# REID_WEIGHTS_SHA256=
